<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">


<div class="container py-5 d-flex flex-column align-items-center justify-content-center">
    <div class="card shadow-lg rounded-4 p-4" style="max-width: 500px;">
      <div class="card-body text-center">
        <h1 class="mb-4 fw-bold text-success">
          <i class="bi bi-patch-check-fill me-2"></i> Merci pour votre inscription ! 🎉
        </h1>
  
        <p class="lead mb-4">Nous avons bien enregistré votre abonnement.</p>
  
        <ul class="list-group list-group-flush text-start mb-4">
          <li class="list-group-item">
            <i class="bi bi-person-fill me-2 text-primary"></i> <strong>Nom :</strong> <%= subscriber.name %>
          </li>
          <li class="list-group-item">
            <i class="bi bi-envelope-fill me-2 text-primary"></i> <strong>Email :</strong> <%= subscriber.email %>
          </li>
          <li class="list-group-item">
            <i class="bi bi-geo-fill me-2 text-primary"></i> <strong>Code Postal :</strong> <%= subscriber.zipCode %>
          </li>
        </ul>
  
        <a href="/" class="btn btn-primary btn-lg">
          <i class="bi bi-house-door-fill me-2"></i> Retour à l'accueil
        </a>
      </div>
    </div>
  </div>
  
  <!-- Assurez-vous que Bootstrap Icons est chargé -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  