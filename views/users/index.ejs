
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Ajouter des icônes (optionnel) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="/path/to/bootstrap/dist/css/bootstrap.min.css">
    <script src="/path/to/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
<style>
    /* Style personnalisé */
    .table-container {
        margin-top: 20px;
    }
    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
    }
    .btn-primary:hover {
        background-color: #0056b3;
        border-color: #0056b3;
    }
    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
    }
    .btn-danger:hover {
        background-color: #c82333;
        border-color: #c82333;
    }
</style>
</head>
<body>
<div class="container">
    <h2 class="mt-4 mb-4">Liste des utilisateurs</h2>
    <div class="table-container">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Email</th>
                    <th>Code Postal</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(user => { %>
                    <tr>
                        <td>
                            <a href="<%= `/users/${user._id}` %>">
                                <%= user.fullName %>
                            </a>
                        </td>
                        <td><%= user.email %></td>
                        <td><%= user.zipCode %></td>
                        <td>
                            <a href="<%= `/users/${user._id}/edit` %>" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil-square"></i> Modifier
                            </a>
                            <a href="<%= `/users/${user._id}/delete?_method=DELETE` %>"
                               class="btn btn-sm btn-danger ms-2"
                               onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur?')">
                                <i class="bi bi-trash"></i> Supprimer
                            </a>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
    <a href="/users/new" class="btn btn-primary mt-3">
        <i class="bi bi-plus-circle"></i> Créer un nouvel utilisateur
    </a>
</div>
