<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">


<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="fw-bold">📚 Liste des cours</h2>
      <a href="/courses/new" class="btn btn-primary">
        <i class="bi bi-plus-circle-fill me-2"></i> Créer un nouveau cours
      </a>
    </div>
  
    <% if (courses && courses.length > 0) { %>
      <div class="table-responsive">
        <table class="table table-hover table-striped align-middle">
          <thead class="table-primary">
            <tr>
              <th>Titre</th>
              <th>Description</th>
              <th>Coût</th>
              <th>Nb Max Étudiants</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% courses.forEach(course => { %>
              <tr>
                <td>
                  <a href="/courses/<%= course._id %>" class="text-decoration-none fw-semibold">
                    <i class="bi bi-book-fill me-2"></i> <%= course.title %>
                  </a>
                </td>
                <td><%= course.description %></td>
                <td><%= course.cost %> €</td>
                <td><%= course.maxStudents %></td>
                <td class="d-flex gap-2">
                  <a href="/courses/<%= course._id %>/edit" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-pencil-square"></i> Modifier
                  </a>
                  <form action="/courses/<%= course._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce cours?');">
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                      <i class="bi bi-trash3-fill"></i> Supprimer
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="alert alert-warning text-center">
        Aucun cours disponible pour le moment.
      </div>
    <% } %>
  </div>
  
  <!-- Ajoute les Bootstrap Icons si ce n'est pas déjà fait -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
  